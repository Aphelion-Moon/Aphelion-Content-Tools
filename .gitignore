# Python
__pycache__/
*.py[cod]
*.tmp
*.egg-info/
build/
dist/
!webapp/frontend/dist/
!webapp/frontend/dist/**

# Node / frontend build
node_modules/
.vite/
*.tsbuildinfo
# The OpenAPI intermediate is regenerated and ignored. The generated TypeScript contract is tracked so a
# clean checkout can typecheck, and CI verifies that regeneration produces no diff.
webapp/frontend/openapi.json

# Generated data and local caches -- rebuilt by their own tool jobs, never committed.
tools/lore_editor/stages/*
!tools/lore_editor/stages/.gitkeep
tools/logs/
tools/content_graph/cache/
webapp/store/data/
webapp/store/projections/
webapp/store/active-projection.json
webapp/store/previous-projection.json
webapp/store/workspace-lease.json

# NOTE: .agents/*.md is deliberately tracked. Those files carry the framing that distinguishes
# Meridian-Rift game-checkout conventions from this repository's own, which only helps if it reaches
# every machine and every agent that opens the repo.
