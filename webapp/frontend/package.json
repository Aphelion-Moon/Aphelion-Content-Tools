{
  "name": "aphelion-content-tools-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run gen:api && npm run typecheck && npm test -- --run && npm run build",
    "gen:api": "python ../dump_openapi.py --output openapi.json && openapi-typescript openapi.json -o src/lib/api-schema.d.ts",
    "gen:api:live": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/lib/api-schema.d.ts"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.3",
    "d3-force": "^3.0.0",
    "graphology": "^0.26.0",
    "howler": "^2.2.4",
    "sigma": "^3.0.3",
    "solid-js": "^1.9.4"
  },
  "devDependencies": {
    "@tanstack/solid-virtual": "^3.11.2",
    "@types/d3-force": "^3.0.10",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.1",
    "axe-core": "^4.13.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-solid": "^2.11.1",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
